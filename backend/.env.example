# ===== DATABASE =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=loyalty_saas
PORT=5000

# ===== JWT =====
JWT_SECRET=your_super_secret_key_change_this_in_production

# ===== APPLE WALLET =====
# Configuration pour la génération de passes Apple Wallet
# CERTIFICAT: Obtenir depuis Apple Developer Account (Pass Type ID Certificate)
# Format: PKCS#12 (.p12) ou PEM séparé (cert.pem + key.pem)
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_PASS_TYPE_ID=pass.com.enterprise.loyaltycard
APPLE_CERT_PATH=./certs/apple-wallet-cert.p12
APPLE_CERT_PASSWORD=

# APPLE WWDR (Certificat Apple Worldwide Developer Relations CA)
# Télécharger depuis: https://developer.apple.com/account/
APPLE_WWDR_CERT_PATH=./certs/AppleWWDRCA.cer

# APPLE PUSH NOTIFICATIONS (APNs)
# Clé P8 pour les notifications push (obtenir depuis Apple Developer)
APPLE_APN_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
APPLE_APN_KEY_ID=XXXXXXXXXX
APPLE_APN_TEAM_ID=XXXXXXXXXX
# Environment: production ou development
APPLE_APN_ENVIRONMENT=development

# ===== APPLE WALLET WEB SERVICE =====
# URL où Apple Wallet enverra les requêtes de mise à jour
# DOIT être accessible et en HTTPS
APPLE_WALLET_WEBSERVICE_URL=https://your-domain.com/api/wallet
APPLE_WALLET_IGNORE_EXPIRY=false

# ===== GOOGLE WALLET =====
GOOGLE_WALLET_KEY_PATH=./certs/google-wallet-key.json
GOOGLE_WALLET_ISSUER_ID=3388000000000000000

# ===== FRONTEND URL =====
FRONTEND_URL=http://localhost:3000

# ===== EMAIL CONFIGURATION =====
# SMTP Configuration (Outlook/Office365)
MAIL_HOST=smtp-mail.outlook.com
MAIL_PORT=587
MAIL_USER=your-email@outlook.fr
MAIL_PASS=your-app-password

# Brevo API Key (Alternative for transactional emails)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== BACKEND URL =====
BACKEND_URL=https://your-domain.com

# ===== OAuth (Google) =====
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://your-domain.com/oauth/callback

# ===== STRIPE CONFIGURATION =====
# Get API keys from: https://dashboard.stripe.com/apikeys
# In development, use test keys (sk_test_*, pk_test_*)
# In production, use live keys (sk_live_*, pk_live_*)

# Stripe Secret Key (Keep this private!)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Stripe Publishable Key (Safe to expose in frontend)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Stripe Webhook Secret (For webhook endpoint signature verification)
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Optional: Stripe Product/Price IDs for subscription tiers
# Create products in Stripe Dashboard: https://dashboard.stripe.com/products
# Then set their IDs here to use in the API
# STRIPE_PRODUCT_BASIC=prod_xxxx
# STRIPE_PRICE_BASIC_MONTHLY=price_xxxx
# STRIPE_PRICE_BASIC_YEARLY=price_xxxx
# STRIPE_PRODUCT_PROFESSIONAL=prod_xxxx
# STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_xxxx
# STRIPE_PRICE_PROFESSIONAL_YEARLY=price_xxxx
# STRIPE_PRODUCT_ENTERPRISE=prod_xxxx
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxxx
# STRIPE_PRICE_ENTERPRISE_YEARLY=price_xxxx
