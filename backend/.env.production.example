# ═══════════════════════════════════════════════════════════════════
# Fidelyz — configuration de PRODUCTION
# Copier en backend/.env sur le serveur (jamais dans git) et remplir.
# Générer un secret : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=5000

# ── Base de données (MySQL 8+ ou MariaDB 10.6+) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fidelyz
DB_USER=fidelyz
DB_PASSWORD=
DB_POOL_SIZE=20

# ── Sécurité ── (32 caractères aléatoires minimum, sinon le serveur refuse de démarrer)
JWT_SECRET=

# ── URLs publiques ── (https obligatoire en production)
FRONTEND_URL=https://fidelyzapp.fr
BACKEND_URL=https://fidelyzapp.fr
ALLOWED_ORIGINS=https://fidelyzapp.fr,https://www.fidelyzapp.fr

# ── E-mails transactionnels (Brevo) ──
# L'expéditeur doit être une adresse d'un domaine vérifié dans Brevo (SPF + DKIM).
BREVO_API_KEY=
MAIL_USER=no-reply@fidelyzapp.fr
MAIL_SENDER_NAME=Fidelyz

# ── Apple Wallet : certificat du Pass Type ID ──
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.fr.fidelyzapp.loyalty
APPLE_CERT_PATH=./certs/pass-cert.pem
APPLE_KEY_PATH=./certs/pass-key.pem
APPLE_CERT_PASSWORD=
# URL appelée par les iPhone pour mettre les cartes à jour (HTTPS, se termine par /api/wallet)
APPLE_WALLET_WEBSERVICE_URL=https://fidelyzapp.fr/api/wallet

# ── Apple Push (clé .p8 « Apple Push Notifications service ») ──
# Indispensable pour que les cartes se mettent à jour et que les notifications s'affichent.
APPLE_APN_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
APPLE_APN_KEY_ID=
APPLE_APN_TEAM_ID=

# ── Google Wallet (compte de service) ──
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_KEY_PATH=./certs/google-wallet-key.json

# ── Stripe ── (facultatif au lancement : sans clé, seule l'offre Gratuite est proposée)
# Les prix sont créés depuis l'admin (Tarifs) : 19 € et 39 € TTC par mois, annuel -20 %.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook à déclarer dans Stripe : https://fidelyzapp.fr/api/stripe/webhook
# Événements : checkout.session.completed, invoice.paid, invoice.payment_failed,
#              customer.subscription.updated, customer.subscription.deleted

# ── Compte Master Admin (node scripts/init-admin.mjs) ──
MASTER_ADMIN_IDENTIFIANT=
MASTER_ADMIN_PASSWORD=

# ── Divers ──
LOG_LEVEL=info
# DISABLE_CRON=true   # uniquement sur des instances supplémentaires
