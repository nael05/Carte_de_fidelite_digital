{
  "name": "fidelyz-video",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Fidelyz out/fidelyz-promo.mp4",
    "render:tiktok": "remotion render Tiktok out/fidelyz-tiktok.mp4",
    "stills": "node scripts/stills.mjs",
    "render:explication": "remotion render Explication out/fidelyz-explication.mp4",
    "textures:tt": "node scripts/textures-tt.mjs",
    "mix:tt": "node scripts/mix-tt.mjs bandeannonce && node scripts/mix-tt.mjs keynote && node scripts/mix-tt.mjs concurrent && node scripts/mix-tt.mjs noir && node scripts/mix-tt.mjs chrono",
    "render:bande-annonce": "remotion render BandeAnnonce out/tt-1-bande-annonce.mp4 --gl=angle --crf=16",
    "render:keynote": "remotion render Keynote out/tt-2-keynote.mp4 --gl=angle --crf=16",
    "render:concurrent": "remotion render Concurrent out/tt-3-concurrent.mp4 --gl=angle --crf=16",
    "render:noir": "remotion render Noir out/tt-4-noir.mp4 --gl=angle --crf=16",
    "render:chrono": "remotion render Chrono out/tt-5-chrono.mp4 --gl=angle --crf=16",
    "sons:tt": "node scripts/sons-tt.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@remotion/cli": "^4.0.539",
    "@remotion/three": "^4.0.539",
    "lucide-react": "^0.460.0",
    "postprocessing": "^6.36.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.539",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "msedge-tts": "^2.1.1",
    "opentype.js": "^2.0.0"
  }
}
